# Würzburg 環境變數設定範例
# 請複製為 .env 並依實際園區環境調整（正式部署時請務必設定強密碼與隨機金鑰）

WURZBURG_HTTP_PORT=8080
WURZBURG_ENV=production
WURZBURG_CAMPUS_NAME=Würzburg
WURZBURG_TIMEZONE=Asia/Taipei

# MariaDB 資料庫設定
WURZBURG_DB_NAME=wurzburg
WURZBURG_DB_USER=wurzburg
WURZBURG_DB_PASSWORD=please_change_db_password
WURZBURG_DB_ROOT_PASSWORD=please_change_root_password

# 首次啟動自動建立第一個系統管理員（至少 12 字元；首次登入後請移除初始密碼）
WURZBURG_ADMIN_USERNAME=admin
WURZBURG_ADMIN_PASSWORD=please_change_admin_password_12chars

# 用於資料庫機敏欄位加密之 32 位元組隨機金鑰（可使用 openssl rand -hex 32 產生）
WURZBURG_SECRET_KEY=please_generate_random_hex_secret_key
