# 平台：Cisco IOS-XE (Catalyst 9300 / IOS-XE 17.x)
# 情境：預設 VRF（全域路由表）完整回應範例，包含一般動態 ARP、靜態 ARP、無效列、閘道位址、HSRP 虛擬 MAC 與次要位址（Secondary IP）
# SNMP 版本：SNMPv2c（community: public）或 SNMPv3（預設空 context）
# 來源依據：RFC 1213 (MIB-II ipNetToMediaTable / ipAddrTable)、RFC 2863 (IF-MIB)、Cisco Catalyst IOS-XE SNMP MIB 實測公開格式（標示為推定：具體介面索引與範例 IP/MAC 為依規範組裝之測試資料）
# 狀態：推定（依據原廠 MIB 規範組裝，待實機驗證）

# --- 1. 介面名稱：IF-MIB::ifName (.1.3.6.1.2.1.31.1.1.1.1) ---
.1.3.6.1.2.1.31.1.1.1.1.10 = STRING: "GigabitEthernet1/0/1"
.1.3.6.1.2.1.31.1.1.1.1.11 = STRING: "Vlan10"
.1.3.6.1.2.1.31.1.1.1.1.12 = STRING: "Vlan20"
.1.3.6.1.2.1.31.1.1.1.1.13 = STRING: "Loopback0"

# --- 2. 介面名稱備援：IF-MIB::ifDescr (.1.3.6.1.2.1.2.2.1.2) ---
.1.3.6.1.2.1.2.2.1.2.10 = STRING: "GigabitEthernet1/0/1"
.1.3.6.1.2.1.2.2.1.2.11 = STRING: "Vlan10"
.1.3.6.1.2.1.2.2.1.2.12 = STRING: "Vlan20"
.1.3.6.1.2.1.2.2.1.2.13 = STRING: "Loopback0"

# --- 3. 介面位址表：RFC1213-MIB::ipAddrTable (.1.3.6.1.2.1.4.20.1) ---
# Vlan10 主位址 10.10.10.2/24、次要位址（Secondary）10.10.11.2/25
# Vlan20 主位址 10.10.20.2/24
# Loopback0 位址 192.168.255.1/32
.1.3.6.1.2.1.4.20.1.1.10.10.10.2 = IpAddress: 10.10.10.2
.1.3.6.1.2.1.4.20.1.1.10.10.11.2 = IpAddress: 10.10.11.2
